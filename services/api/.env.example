# Nexova API - Configuración de entorno local y demo
# Copia este archivo a .env para desarrollo local. Nunca versiones valores secretos reales.

# JWT y Seguridad
JWT_SECRET_KEY=change_this_to_a_secure_secret_key_with_at_least_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rutas de almacenamiento local TinyDB
NEXOVA_AUTH_DB_PATH=data/auth.json
NEXOVA_SUPPLIERS_DB_PATH=data/suppliers.json

# AUTH-03: Servicio de correo transaccional (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
NEXOVA_FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

